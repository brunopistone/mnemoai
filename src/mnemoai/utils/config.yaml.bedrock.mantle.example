# AWS Bedrock Mantle: auth via a short-lived bearer token minted from your
# standard AWS (SigV4) credentials. Model IDs are bare provider names. Mantle
# serves models under different protocols, selected with API_PROTOCOL:
#   chat_completions (default) -> base /v1 (OpenAI Chat Completions); most models
#   responses                  -> base /openai/v1 (OpenAI Responses); e.g. openai.gpt-5.4
#   anthropic                  -> base /anthropic (Anthropic Messages); Claude models
# Works for both MODEL_ID (chat) and VISION_MODEL_ID (image description).
MODEL_ID:
  NAME: qwen.qwen3-32b # bare Mantle model id
  TYPE: mantle
  REGION: us-east-1
  MAX_TOKENS: 8192
  # Auth: by default a short-lived token is minted from AWS credentials. To use
  # a short-term Bedrock API key instead, uncomment API_KEY here (per-model) or
  # set BEDROCK_API_KEY in the ENV section at the bottom (applies to all calls).
  # API_KEY: bedrock-api-key-XXXXXXXX
# Responses-API model example (GPT-5.4 lives in us-west-2, not us-east-1):
# MODEL_ID:
#   NAME: openai.gpt-5.5
#   TYPE: mantle
#   REGION: us-west-2
#   API_PROTOCOL: responses
#   MAX_TOKENS: 128000
#   # Reasoning is a first-class knob, translated per protocol. On the responses
#   # protocol it becomes reasoning={"effort": <effort>, "summary": "auto"} so
#   # the model's reasoning SUMMARY streams back and is shown (in verbose mode);
#   # effort alone would reason invisibly. Also tunable via /params.
#   REASONING_EFFORT: high   # none|minimal|low|medium|high|xhigh|max
#   # EXTRA_PARAMS is forwarded verbatim and overrides the above — e.g. to set a
#   # different summary level, or disable the summary, pass your own `reasoning`:
#   # EXTRA_PARAMS:
#   #   reasoning: { effort: high, summary: detailed }   # or summary: none
#   #   verbosity: low
# Anthropic (Claude) model example:
# MODEL_ID:
#   NAME: anthropic.claude-opus-4-8
#   TYPE: mantle
#   REGION: us-east-1
#   API_PROTOCOL: anthropic
#   MAX_TOKENS: 128000
#   # On the anthropic protocol REASONING_EFFORT enables extended thinking
#   # automatically (temperature/top_p are dropped when thinking is on). The
#   # request FORM is chosen by model version: Claude Opus 4.7+ uses
#   # thinking={type: adaptive, display: summarized} + output_config.effort
#   # (the older enabled+budget form is rejected by these models); Claude <=4.5
#   # uses thinking={type: enabled, budget_tokens: …}.
#   REASONING_EFFORT: high
#   # Override the raw block yourself via EXTRA_PARAMS if version detection is
#   # wrong for your model (overrides the above):
#   # EXTRA_PARAMS:
#   #   thinking: { type: adaptive, display: summarized }
#   #   output_config: { effort: high }
# MODEL_ID:
#   NAME: xai.grok-4.3
#   TYPE: mantle
#   REGION: us-west-2
#   API_PROTOCOL: responses
#   MAX_TOKENS: 30000
# Vision via Mantle (vision-capable models):
VISION_MODEL_ID:
  NAME: qwen.qwen3-vl-235b-a22b-instruct
  TYPE: mantle
  REGION: us-east-1
# VISION_MODEL_ID:
#   NAME: openai.gpt-5.5
#   TYPE: mantle
#   REGION: us-east-1
#   API_PROTOCOL: responses
# VISION_MODEL_ID:
#   NAME: anthropic.claude-opus-4-8
#   TYPE: mantle
#   REGION: us-east-1
#   API_PROTOCOL: anthropic
# VISION_MODEL_ID:
#   NAME: xai.grok-4.3
#   TYPE: mantle
#   REGION: us-west-2
#   API_PROTOCOL: responses
# Model parameters
#Anthropic max context window
MAX_CONVERSATION_TOKENS: 1000000
#GPT max context window
#MAX_CONVERSATION_TOKENS: 272000
DOC_MAX_TOKENS: 524288
# Days a recorded session is kept for `mnemoai --resume` (0 disables recording
# entirely). Saved conversations (/save) live elsewhere and never expire.
SESSION_MAX_AGE_DAYS: 30

# Ask for confirmation before every execute_bash shell command.
# Set to false to run shell commands without prompting (trusted/automation setups).
REQUIRE_BASH_CONFIRMATION: true
# Ask for confirmation before every fs_write / file_edit file modification.
# Set to false to write files without prompting (trusted/automation setups).
REQUIRE_WRITE_CONFIRMATION: true
# Ask for confirmation before each persistent-memory write (default off:
# the agent curates MEMORY.md automatically, Hermes-style). Set true to gate.
REQUIRE_MEMORY_CONFIRMATION: false
# Ask for confirmation when a tool refuses a risky git operation and the call
# asks to override it (unsafe amend, force push, hard reset). Set to false to
# let the override through unprompted (trusted/automation setups).
REQUIRE_GIT_CONFIRMATION: true
# RAG Configuration
ENABLE_RAG: true
RAG:
  MAX_TOKENS: 8192
  EMBED_MODEL_ID:
    NAME: qwen3-embedding:0.6b
    TYPE: ollama
    HOST: localhost
    PORT: 11434
    # MAX_INPUT_TOKENS: 8192   # cap embed input to the model's context; omit to
    #                          # auto-resolve (Ollama context probe, else a safe default)
  CHUNK_TOKENS: 1024
  SEARCH:
    SEMANTIC_WEIGHT: 0.5 # Semantic similarity weight (0-1)
    KEYWORD_WEIGHT: 0.5 # BM25 keyword weight (0-1)
  VECTOR_STORE:
    TYPE: chromadb # or faiss
  EMBEDDINGS:
    FALLBACK_ENABLED: true
    FALLBACK_TYPE: "sha256" # or "random", "zeros"
    CACHE_ENABLED: true
    CACHE_SIZE: 1000 # LRU cache size for embeddings
# Episodic Memory Configuration (Enhanced)
ENABLE_EPISODIC_MEMORY: true
EPISODIC_MEMORY:
  ENABLED: true
  STORE_TYPE: chromadb # or faiss
  # Similarity Thresholds
  DUPLICATE_THRESHOLD: 0.95 # Higher = stricter duplicate detection
  RETRIEVAL_THRESHOLD: 0.7 # Higher = more strict retrieval
  # Hybrid Search Weights
  SEMANTIC_WEIGHT: 0.7 # Semantic similarity weight (0-1)
  KEYWORD_WEIGHT: 0.3 # Keyword matching weight (0-1)
  # Token and Size Limits
  MAX_TOKENS_PER_EPISODE: 400 # Max tokens for episode text
  MAX_EPISODES: 1000 # Maximum stored episodes
  MAX_AGE_DAYS: 90 # Maximum episode age
  # Success Detection (configurable markers)
  SUCCESS_MARKERS:
    - thanks
    - thank you
    - perfect
    - great
    - worked
    - good
    - excellent
    - awesome
  CORRECTION_MARKERS:
    - wrong
    - error
    - fix
    - actually
    - instead
    - incorrect
    - "no"
    - not right
  ERROR_PATTERNS:
    - "error:"
    - "failed:"
    - "exception:"
    - "could not"
    - "unable to"
    - "error occurred"
    - "failed to"
    - "an error"
    - "the error"
  # Storage Behavior
  IMMEDIATE_STORAGE: true # Store episodes immediately (not delayed)
  MIN_TOOLS_OR_LENGTH: 300 # Minimum response length if no tools used
  # Query Enhancement
  ENABLE_QUERY_EXPANSION: true # Expand queries with synonyms
  QUERY_EXPANSION_TERMS: 3 # Max terms to add per query
# Persistent curated memory (MEMORY.md): a small, bounded markdown file the
# agent maintains itself and that is injected whole into the system prompt at
# session start. Complements episodic memory (which is similarity-retrieved).
ENABLE_MEMORY: true
MEMORY:
  MAX_CHARS: 2200   # hard cap; agent must consolidate when full
# Auto-extraction: after each turn, a background pass distills durable facts from
# the exchange and writes them to MEMORY.md — the auto-learning counterpart to the
# model calling the `memory` tool itself. OFF by default: unlike the tool, it
# writes WITHOUT a confirmation prompt (confined to MEMORY.md). Costs one extra
# background model call per turn when on.
ENABLE_MEMORY_AUTO_EXTRACTION: false
# Agent Skills: authored SKILL.md instruction packs under ~/.mnemoai/skills/
# (one <name>/SKILL.md per skill). Only each skill's name+description is injected
# into the system prompt; the model loads a full skill body on demand via the
# use_skill tool. A bundled example skill is seeded on first run.
ENABLE_SKILLS: true
# ACE Playbook Configuration (Agentic Context Engineering)
ENABLE_PLAYBOOK: true
PLAYBOOK:
  MAX_ENTRIES: 500 # Maximum playbook entries before refinement
  SIMILARITY_THRESHOLD: 0.85 # Threshold for merging similar strategies
  MAX_INJECT: 10 # Maximum entries to inject per query

# Query Routing Configuration
# When enabled, queries are classified and routed to specialized tool subsets
# Categories: simple_qa (no tools), code, research, knowledge, full (all tools)
ENABLE_ROUTING: true
ENABLE_ORCHESTRATION: true
LLM:
  # Thinking/Reasoning
  ENABLE_THINKING: true # Enable thinking tags (verbose mode)
  # Retry Logic
  RETRY_ENABLED: true
  MAX_RETRIES: 5 # Also caps retries of a transient *empty* model response
  RETRY_DELAY: 1.0 # Seconds between retries
  RETRY_BACKOFF: 2.0 # Exponential backoff multiplier
  # When a turn is cut off by MODEL_ID.MAX_TOKENS mid-response (reasoning + answer
  # exceeded the output budget), auto-continue: feed the partial back and resume,
  # so you never have to type "continue". This many continuation attempts (0
  # disables — then a cut-off turn surfaces an "increase MAX_TOKENS" message).
  MAX_OUTPUT_CONTINUE_RETRIES: 3
  # Per-chunk idle timeout on a streaming response (seconds; 0 disables). A
  # stream that goes silent this long — e.g. the socket died when the laptop
  # slept — is abandoned so it can't hang the app; the turn then re-runs on a
  # fresh connection with backoff (the provider's request timeout only covers
  # getting response headers, not a stalled streaming body).
  STREAM_IDLE_TIMEOUT: 120
  # Token Counting (Model-specific)
  TOKEN_COUNTING:
    OLLAMA_APPROXIMATION: 1.3 # Multiplier for Ollama (chars to tokens)
  # Context Management
  SUMMARIZATION_THINK: false
  # Compaction: when the conversation exceeds MAX_CONVERSATION_TOKENS it is
  # auto-compacted — older messages are summarized into the system prompt while
  # the most recent messages are kept verbatim.
  KEEP_RECENT_MESSAGES: 6
  # The manual /compact command keeps a smaller window (so it still shrinks a
  # short conversation on demand).
  MANUAL_COMPACT_KEEP_RECENT: 2
  # The kept-verbatim window is ALSO bounded by tokens, walking newest->oldest.
  # This ensures a single oversized recent message (e.g. a pasted document that
  # alone fills the context window) is summarized rather than kept verbatim.
  # Defaults to 25% of MAX_CONVERSATION_TOKENS when unset.
  KEEP_RECENT_TOKEN_BUDGET: 16384
  # Proactive pre-turn compaction and the per-tool-result cap both auto-derive
  # from MAX_CONVERSATION_TOKENS (the model's context window) when left unset, so
  # they scale with the model rather than a fixed number:
  #   COMPACT_HIGH_WATER_TOKENS -> 80% of the window (compact before a turn when
  #                                history exceeds it; 0 disables the check)
  #   MAX_TOOL_RESULT_CHARS     -> 10% of the window in chars (~4 chars/token);
  #                                caps one tool result (head+tail kept with a
  #                                truncation note) so a runaway result can't
  #                                alone overflow the window; 0 disables
  # Uncomment to override:
  # COMPACT_HIGH_WATER_TOKENS: 800000
  # MAX_TOOL_RESULT_CHARS: 400000
  # Cheapest compaction layer, tried BEFORE any summary when over the high-water
  # mark: old tool-result bodies (grep/read/web dumps outside the recent window)
  # are shrunk in place to a short head + a marker, with no model call. If that
  # alone gets back under budget the summary is skipped. Recent turns stay
  # verbatim; no message is dropped (tool-call/result pairing is preserved).
  #   TOOL_EVICTION_KEEP_RECENT -> messages kept fully verbatim (default 8)
  #   EVICTED_TOOL_RESULT_CHARS -> char cap an evicted result is shrunk to
  #                                (default 500; 0 disables the layer)
  # TOOL_EVICTION_KEEP_RECENT: 8
  # EVICTED_TOOL_RESULT_CHARS: 500
  # Max model<->tools steps per query before the agent loop is cut short and a
  # partial result is returned (LangGraph recursion_limit). Set high so
  # legitimate long tasks aren't capped — context compaction is the real
  # limiter; this is just a runaway guard.
  RECURSION_LIMIT: 200
  # Max sub-agents (spawn_agent) run in parallel from one turn's tool calls; the
  # rest queue. 1 forces sequential. A single spawn always runs inline.
  SUBAGENT_MAX_CONCURRENCY: 4
  # Upper bound (seconds) for a single MCP tool call at the transport layer.
  # Must exceed the longest tool-level timeout (execute_bash allows up to 120s).
  MCP_CALL_TIMEOUT: 300
# Web search Configuration
ENABLE_WEB_SEARCH: true
BRAVE_API_KEY: your_brave_api_key
# Web crawl Configuration
ENABLE_WEB_CRAWL: true
# File system paths
PROFILE:
  NAME: bpistone
  USE_PROFILING: true
# Environment variables exported at startup. Mantle mints its bearer token from
# the standard AWS credential chain; set AWS_PROFILE here to use a named profile,
# or set BEDROCK_API_KEY to authenticate with a short-term Bedrock API key
# instead (no AWS credentials needed).
# ENV:
#   AWS_PROFILE: my-bedrock-profile
#   AWS_REGION: us-east-1
#   BEDROCK_API_KEY: bedrock-api-key-XXXXXXXX
